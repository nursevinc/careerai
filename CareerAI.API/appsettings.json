{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      },
      { "Name": "Debug" }
    ]
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175"
    ]
  },

  "Jwt": {
    "Issuer": "CareerAI.API",
    "Audience": "CareerAI.UI",
    "ExpiryMinutes": 60
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "MaxOutputTokens": 2000,
    "TimeoutSeconds": 60,
    "Temperature": 0
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AiPermitLimit": 10
  }
}